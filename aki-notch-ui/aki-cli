func cmdCharacters(client: AkiClient, args: Args) {
    let (status, body) = client.get("/characters", timeout: 5)
    if status == 200 {
        if args.jsonOutput {
            out(body)
        } else {
            guard let data = body.data(using: .utf8),
                let arr = try? JSONSerialization.jsonObject(with: data) as? [[String: Any]]
            else {
                out(body)
                return
            }
            if arr.isEmpty {
                out(C.styled("No characters loaded.", C.dim))
                return
            }
            for char in arr {
                let name = char["name"] as? String ?? "?"
                let accent = char["accent_hex"] as? String ?? "#7FD6FF"
                let faces = (char["faces"] as? [String]) ?? []
                let faceList = faces.isEmpty ? C.styled("(no faces)", C.dim) : faces.joined(separator: ", ")
                out(C.styled("●", C.cyan) + " " + C.styled(name, C.bold) + "  " + C.styled(accent, C.dim))
                out("  faces: " + faceList)
            }
        }
    } else {
        die("server returned \(status): \(body)")
    }
}

func cmdHelp() {
    let h = C.styled
    let b = C.bold
    let d = C.dim
    let c = C.cyan
    let y = C.yellow

    let help = """
        \(h("aki", b)) — CLI companion for aki-notch-ui

        \(h("USAGE:", b))
            aki <command> [options]

        \(h("COMMANDS:", b))
            \(h("notify", c))    Send a notification to the notch
            \(h("ask", c))       Ask a question (blocks until answered)
            \(h("listen", c))    Wait for user to compose a message (⌘⇧K)
            \(h("say", c))       Send a message to the notch as the user
            \(h("game", c))      Start a mini-game (blocks until finished)
            \(h("characters", c))  List loaded characters and their faces
            \(h("health", c))    Check if the app is running
            \(h("collapse", c))  Hide the current card
            \(h("clear", c))     Clear all state
            \(h("help", c))      Show this help message
            \(h("version", c))   Print version

        \(h("GLOBAL OPTIONS:", b))
            \(h("--port", y)) <PORT>       Override the API port (default: 47037)
            \(h("--timeout", y)) <SECS>    Request timeout in seconds (default: 300)
            \(h("--json", y))              Output raw JSON instead of parsed text
            \(h("--chara", y)) <NAME>     Use a character's face, name & color
            \(h("--face", y)) <MOOD>      Which face/mood to use (default: first)
        \(h("NOTIFY:", b))
            aki notify <message> [\(h("--name", y)) NAME] [\(h("--color", y)) HEX] [\(h("--accent", y)) HEX]
                                  [\(h("--title", y)) TITLE] [\(h("--image-url", y)) URL]
                                  [\(h("--image-base64", y)) DATA]

        \(h("ASK:", b))
            aki ask <message> [\(h("--answers", y)) "A,B,C"] [\(h("--name", y)) NAME] [\(h("--color", y)) HEX]
                              [\(h("--accent", y)) HEX] [\(h("--title", y)) TITLE]

        \(h("SAY:", b))
            aki say <message> [\(h("--name", y)) NAME] [\(h("--accent", y)) HEX] [\(h("--color", y)) HEX]

        \(h("GAME:", b))
            aki game <tic_tac_toe|snake|hangman>
                     [\(h("--mode", y)) user_guesses|agent_guesses]  \(h("(hangman only)", d))
                     [\(h("--word", y)) WORD]                        \(h("(hangman only)", d))
                     [\(h("--accent", y)) HEX]

        \(h("CHARACTER:", b))
            Use \(h("--chara", y)) with notify, ask, say, or game to show a character:
            \(h("$", d)) aki notify "Hello!" --chara Aki
            \(h("$", d)) aki notify "Grr!" --chara Aki --face angry
            \(h("$", d)) aki ask "Play?" --chara Haruna --answers "Yes,No"

        \(h("EXAMPLES:", b))
            \(h("$", d)) aki notify "Hello world!"
            \(h("$", d)) aki notify "Build done" --name CI --color "#00FF00"
            \(h("$", d)) aki ask "Deploy?" --answers "Yes,No,Rollback"
            \(h("$", d)) aki ask "Name?" --name Aki --json
            \(h("$", d)) aki say "remind me to review the PR at 5pm"
            \(h("$", d)) aki game tic_tac_toe
            \(h("$", d)) aki game hangman --mode user_guesses
            \(h("$", d)) aki listen
            \(h("$", d)) aki health
            \(h("$", d)) aki collapse
            \(h("$", d)) aki clear
            \(h("$", d)) aki characters
            \(h("$", d)) aki notify "Hello!" --chara Aki --face happy

            \(h("# Scripting — capture the answer:", d))
            \(h("$", d)) answer=$(aki ask "Continue?" --answers "Yes,No")
            \(h("$", d)) echo "User said: $answer"

            \(h("# Pipe listen into another command:", d))
            \(h("$", d)) aki listen | xargs echo "User composed:"
        """
    out(help)
}
// MARK: - Main

let args = Args(CommandLine.arguments)
let client = AkiClient(port: args.port, timeout: args.timeout)

switch args.command {
case "notify", "n":
    cmdNotify(client: client, args: args)
case "ask", "a":
    cmdAsk(client: client, args: args)
case "listen", "l":
    cmdListen(client: client, args: args)
case "say", "s":
    cmdSay(client: client, args: args)
case "game", "g":
    cmdGame(client: client, args: args)
case "health", "ping":
    cmdHealth(client: client, args: args)
case "collapse":
    cmdCollapse(client: client, args: args)
case "clear":
    cmdClear(client: client, args: args)
case "characters", "chars", "c":
    cmdCharacters(client: client, args: args)
case "help", "--help", "-h":
    cmdHelp()
case "version", "--version", "-v":
    out("aki \(kVersion)")
default:
    FileHandle.standardError.write(Data("unknown command: \(args.command)\n".utf8))
    cmdHelp()
    exit(1)
}
